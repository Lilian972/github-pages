├── tailwind.config.js
├── styles/
│   └── globals.css
├── pages/
│   ├── _app.js
│   └── index.js
├── components/
│   └── ConfiaImmersiveHome.js
└── public/
    └── images/
        ├── plomberie.jpg
        ├── electricite.jpg
        ├── plombier_a.jpg
        ├── plombier_b.jpg
        ├── plombier_c.jpg
        ├── electricien_a.jpg
        ├── electricien_b.jpg
